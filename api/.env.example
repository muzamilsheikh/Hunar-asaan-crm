# ============================================
# HUNAR ASAAN BACKEND - ENVIRONMENT VARIABLES
# FOR VERCEL SERVERLESS DEPLOYMENT
# ============================================

# ============ SERVER CONFIGURATION ============
NODE_ENV=production
PORT=3000

# ============ FRONTEND URL ============
APP_URL=https://hunar-asaan-crm.vercel.app

# ============ DATABASE CONFIGURATION (CRITICAL) ============
# Use Aiven MySQL or any cloud MySQL provider
DB_HOST=your-db-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=hunar_db

# ============ AUTHENTICATION (CRITICAL) ============
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secure-key-here-min-32-chars

# ============ SMTP EMAIL CONFIGURATION ============
# Gmail Setup: Use 16-char App Password (not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=noreply@hunar-asaan.com

# ============ OPTIONAL SETTINGS ============
LOG_LEVEL=info
ENABLE_SOCKET_IO=true
MAX_UPLOAD_SIZE=10mb
