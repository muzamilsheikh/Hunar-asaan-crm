# ============================================
# HUNAR ASAAN CRM - ENVIRONMENT VARIABLES
# ============================================
# 
# Copy this file to ".env" and fill in your values
#
# ✅ Backend (.env in /server directory)
# ✅ Frontend (.env in root directory)

# ============================================
# BACKEND CONFIGURATION (server/.env)
# ============================================

# Server Mode
NODE_ENV=production                      # Options: development, production

# Server Settings
PORT=5001                                # Port number (default: 5001)
APP_URL=https://yourdomain.com          # Your production domain

# ============================================
# DATABASE CONFIGURATION (CRITICAL)
# ============================================

# Cloud Database Host (AWS RDS, PlanetScale, etc.)
DB_HOST=localhost                        # Replace with cloud DB host
DB_PORT=3306                             # MySQL port (usually 3306)
DB_USER=root                             # Database username
DB_PASSWORD=                             # ⚠️ Set STRONG password!
DB_NAME=hunar_db                         # Database name

# Database Connection Pool
# (Usually don't need to change these)
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# JWT AUTHENTICATION (CRITICAL)
# ============================================

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secure-key-here-min-32-chars

# Token expiration
JWT_EXPIRY=7d

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================

# Gmail Setup:
# 1. Enable 2-Factor Authentication on Gmail
# 2. Generate App Password: myaccount.google.com/apppasswords
# 3. Use the 16-char password below (without spaces)

SMTP_HOST=smtp.gmail.com                 # Gmail SMTP server
SMTP_PORT=587                            # Gmail SMTP port
SMTP_SECURE=false                        # false for port 587, true for 465
SMTP_USER=your-email@gmail.com          # Your Gmail email
SMTP_PASS=your-16-char-app-password     # Gmail App Password (NOT regular password)
SMTP_FROM=noreply@yourdomain.com        # From address in emails

# Alternative (SendGrid):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxx...

# Disable email if not configured
MAIL_DISABLED=false                      # Set true to disable email sending

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed Frontend Origins (update in server/index.js manually)
# Should match where your React frontend is deployed
CORS_ORIGIN_1=https://yourdomain.com
CORS_ORIGIN_2=https://www.yourdomain.com

# ============================================
# FRONTEND CONFIGURATION (.env in root)
# ============================================

# Backend API URL (for API requests)
VITE_API_URL=https://yourdomain.com/api

# WebSocket URL (for real-time features like chat)
VITE_SOCKET_URL=https://yourdomain.com

# Frontend Mode
NODE_ENV=production                      # Options: development, production

# Build outputs
VITE_BUILD_DIR=dist
VITE_ASSETS_DIR=assets

# ============================================
# OPTIONAL FEATURES
# ============================================

# File Upload Limits
MAX_FILE_SIZE=10485760                   # 10MB in bytes

# Session Settings
SESSION_TIMEOUT=3600000                  # 1 hour in milliseconds

# Enable Debug Logging
DEBUG=false

# ============================================
# NOTES
# ============================================
#
# 🔒 SECURITY:
# - Never commit .env to git
# - Use strong, random passwords (min 16 chars)
# - Rotate JWT_SECRET regularly
# - Use environment variable management (Vercel Secrets, etc.)
#
# 📧 EMAIL SETUP:
# - Gmail: Use 16-character App Password (not your regular password)
# - SendGrid: Use API key as SMTP_PASS
# - Other: Contact your email provider for SMTP details
#
# 🌐 DEPLOYMENT:
# - Update DB_HOST to your cloud database location
# - Update APP_URL to your production domain
# - Update CORS origins to match your frontend URL
# - Use environment variables in your hosting platform
#
# 🧪 TESTING:
# - Start with development values
# - Test locally before deploying
# - Verify database connection works
# - Test email sending if configured
#
# ============================================
